{
  "manifest_version": 3,
  "name": "AI Quota Pocket for Windows",
  "version": "0.1.0",
  "description": "Displays Codex and Claude quotas on your Windows desktop.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/codex/settings/usage*",
        "https://chatgpt.com/codex/cloud/settings/analytics*",
        "https://chatgpt.com/settings/usage*",
        "https://claude.ai/settings/usage*"
      ],
      "js": [
        "reader.js",
        "collect.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
